PORT=5000
MONGO_URI=mongodb://localhost:27017/course_file_db
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Google Drive Destination & OAuth 2.0 Web Client Integration
GOOGLE_DRIVE_FOLDER_ID=1kIzXquZB7ayOhTXtunMPwoCdVmx40Kez
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://cfes-portal.onrender.com/api/course-files/google/callback
# Optional: static refresh token override (bypasses MongoDB token persistence if set)
GOOGLE_OAUTH_REFRESH_TOKEN=

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
